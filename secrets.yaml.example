# ============================================================================
# HotWatch — Пример файла secrets.yaml
# ============================================================================
#
# ⚠️  ВАЖНО: Переименуй этот файл в 'secrets.yaml' и заполни свои данные.
#     НИКОГДА не коммитьте secrets.yaml в git репозиторий!
#
# Для использования в hotwatch.yaml:
#   api_encryption_key: !secret api_encryption_key
#
# ============================================================================

# ============================================================================
# WiFi
# ============================================================================

wifi_ssid: "ТВоя_сеть_WiFi"
wifi_password: "ТвойПарольWiFi"
fallback_password: "FallbackPassword123"

# ============================================================================
# ESPHome API (Native API шифрование)
# ============================================================================
# Генерируется автоматически при первой компиляции.
# Скопируй сюда значение из вывода `esphome run hotwatch.yaml`:
#
# [15:30:45][I][api:002]: Starting API Server on 192.168.1.100:6053...
# [15:30:45][I][api:002]: API Encryption Key: "abc123def456..."
#
# Или оставь пусто — ESPHome сгенерирует новый при компиляции.

api_encryption_key: "PlaceYourEncryptionKeyHereOrLeaveEmptyForAuto"

# ============================================================================
# OTA пароль (обновление по воздуху)
# ============================================================================
# Нужен для защиты обновлений прошивки

ota_password: "OTAPassword123"

# ============================================================================
# Home Assistant (опционально, для Native API)
# ============================================================================
# Если будешь использовать HA Integration с явным API token:

ha_api_key: "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ============================================================================
# Telegram (опционально, для уведомлений через HA)
# ============================================================================
# Заполни эти данные для интеграции Telegram (настраивается в HA, не в ESP)

telegram_bot_token: "123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefg"
telegram_chat_id: "987654321"

# ============================================================================
# Параметры датчиков (опционально)
# ============================================================================
# Для калибровки и пороговых значений

mq2_baseline_adc: "200"        # Нормальный уровень дыма при хорошей вентиляции
mq2_alarm_threshold_adc: "400" # Пороговое значение срабатывания тревоги

delta_t_min: "2"               # Минимальный ΔT между подачей и обраткой (°C)

# ============================================================================
# Логирование (опционально)
# ============================================================================

log_level: "INFO"

# ============================================================================
# ИНСТРУКЦИЯ
# ============================================================================
#
# 1. Скопируй этот файл:
#      cp secrets.yaml.example secrets.yaml
#
# 2. Отредактируй secrets.yaml в своём текстовом редакторе:
#      - Установи свой SSID WiFi и пароль
#      - Установи пароль OTA
#      - Скопируй API encryption key после первой компиляции
#
# 3. Убедись, что secrets.yaml добавлен в .gitignore:
#      echo "secrets.yaml" >> .gitignore
#
# 4. Закоммитьте только secrets.yaml.example (БЕЗ реальных данных)
#
# 5. При переносе проекта на другую машину:
#      - Скопируй secrets.yaml.example → secrets.yaml
#      - Заполни новые данные (новый SSID, пароль и т.д.)
#
# ============================================================================
